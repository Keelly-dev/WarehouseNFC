<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WarehouseNFC.Views.ProductsPage"
             Title="Номенклатура"
             BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#1A1A2E}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="24,16,24,8" Spacing="12">

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">
                <Entry Placeholder="🔍 Поиск по наименованию или артикулу"
                       Text="{Binding SearchText}"
                       Margin="12,8"
                       FontSize="16"/>
            </Border>

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                    IsVisible="{Binding IsAdding}">
                <Entry Placeholder="Наименование"
                       Text="{Binding Name}"
                       Margin="12,8"
                       FontSize="16"/>
            </Border>

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                    IsVisible="{Binding IsAdding}">
                <Entry Placeholder="Артикул"
                       Text="{Binding Article}"
                       Margin="12,8"
                       FontSize="16"/>
            </Border>

            <Button Text="Добавить"
                    Command="{Binding ToggleAddCommand}"
                    BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#0D47A1}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    FontSize="18"
                    HeightRequest="56"
                    IsVisible="{Binding IsAdding, Converter={StaticResource InvertBoolConverter}}"/>

            <Button Text="Сохранить"
                    Command="{Binding AddCommand}"
                    BackgroundColor="#43A047"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    FontSize="18"
                    HeightRequest="56"
                    IsVisible="{Binding IsAdding}"/>

            <Button Text="Отмена"
                    Command="{Binding ToggleAddCommand}"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    FontSize="18"
                    HeightRequest="56"
                    IsVisible="{Binding IsAdding}"/>

            <Label Text="{Binding StatusMessage}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{Binding IsError, Converter={StaticResource BoolToColorConverter}}"/>

        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        Margin="24,0,24,24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                            Margin="0,4">
                        <VerticalStackLayout Padding="12" Spacing="4">
                            <Label Text="{Binding Name}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"/>
                            <Label Text="{Binding Article, StringFormat='Артикул: {0}'}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>